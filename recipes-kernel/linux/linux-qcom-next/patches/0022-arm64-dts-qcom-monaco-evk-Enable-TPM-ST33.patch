From b957db43d5d7acee01c8fecaa9dcac07b14f0ee9 Mon Sep 17 00:00:00 2001
From: Khalid Faisal Ansari <khalid.ansari@oss.qualcomm.com>
Date: Tue, 27 Oct 2026 12:48:42 +0530
Subject: [PATCH] arm64: dts: qcom: monaco-evk: Enable TPM (ST33)

Enable ST33HTPM TPM over SPI10 on the Monaco IoT EVK by adding the
required SPI and TPM node

Signed-off-by: Khalid Faisal Ansari <khalid.ansari@oss.qualcomm.com>

Upstream-Status: Pending
---
 arch/arm64/boot/dts/qcom/monaco-draco-evk.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts b/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
index 02cd7d7a58c9..935b25c14e91 100644
--- a/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
+++ b/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
@@ -487,3 +487,12 @@ uart2_ep: endpoint {
 	};
 };
 
+&spi10 {
+	status = "okay";
+
+	tpm@0 {
+		compatible = "st,st33htpm-spi", "tcg,tpm_tis-spi";
+		reg = <0>;
+		spi-max-frequency = <20000000>;
+	};
+};
-- 
2.34.1

