From 53523869bb07e857240e2b2477681dccec266e91 Mon Sep 17 00:00:00 2001
From: Kishor Buchi <kbuchi@qti.qualcomm.com>
Date: Tue, 27 Oct 2026 11:03:55 +0530
Subject: [PATCH 1/3] arm64: dts: qcom: monaco-draco-ac-evk-som: Enable Adreno
 623 GPU

Enable GPU for monaco draco ac platform and provide path for zap
shader.

Upstream-Status: Pending
---
 arch/arm64/boot/dts/qcom/monaco-draco-ac-evk-som.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/monaco-draco-ac-evk-som.dtsi b/arch/arm64/boot/dts/qcom/monaco-draco-ac-evk-som.dtsi
index c24dc068ffd6..e0e91d0e232d 100644
--- a/arch/arm64/boot/dts/qcom/monaco-draco-ac-evk-som.dtsi
+++ b/arch/arm64/boot/dts/qcom/monaco-draco-ac-evk-som.dtsi
@@ -179,6 +179,14 @@ vreg_s5c: smps5 {
 	};
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/qcs8300/a623_zap.mbn";
+};
+
 &qup_i2c13_data_clk {
 	drive-strength = <6>;
 	bias-pull-up;
-- 
2.34.1
