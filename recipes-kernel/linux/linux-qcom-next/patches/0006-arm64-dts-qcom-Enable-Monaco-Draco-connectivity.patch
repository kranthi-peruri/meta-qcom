From 8ed0b40b1cb8dd31c11d9cca4c52515ee075ad4a Mon Sep 17 00:00:00 2001
From: Kranthi Peruri <kperuri@qti.qualcomm.com>
Date: Wed, 28 Oct 2026 14:55:46 +0530
Subject: [PATCH 06/20] arm64: dts: qcom: Enable Monaco Draco connectivity
 Enable the M.2 E-key connectivity slot on Monaco Draco EVK by describing its
 always-on 3.3 V supply and PCIe and UART graph connections.

Describe W_DISABLE2# so pwrseq-pcie-m2 can control Bluetooth power through
UART2.

Upstream-Status: Pending

Signed-off-by: Wei Deng <wei.deng@oss.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/monaco-draco-evk.dts | 72 +++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts b/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
index f4a69fdca093..b0b368fc714a 100644
--- a/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
+++ b/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
@@ -12,6 +12,10 @@ / {
 	compatible = "qcom,monaco-draco-evk", "qcom,qcs8300";
 	chassis-type = "embedded";
 
+	aliases {
+		serial1 = &uart2;
+	};
+
 	vreg_0p9: regulator-0v9 {
 		compatible = "regulator-fixed";
 		regulator-name = "VREG_0P9";
@@ -29,6 +33,50 @@ vreg_1p8: regulator-1v8 {
 		regulator-always-on;
 		regulator-boot-on;
 	};
+
+	vreg_keye_3p3: regulator-keye-3p3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_keye_3p3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	wifi-bt-connector {
+		compatible = "pcie-m2-e-connector";
+		vpcie3v3-supply = <&vreg_keye_3p3>;
+
+		w-disable2-gpios = <&tlmm 55 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&bt_en>;
+		pinctrl-names = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				m2_e_pcie_ep: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&tc9563_pcie1_ep>;
+				};
+			};
+
+			port@3 {
+				reg = <3>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				m2_e_uart_ep: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&uart2_ep>;
+				};
+			};
+		};
+	};
 };
 
 &i2c14 {
@@ -83,6 +131,13 @@ expander5: gpio@3c {
 };
 
 &tlmm {
+	bt_en: bt-en-state {
+		pins = "gpio55";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	pcie0_default_state: pcie0-default-state {
 		clkreq-pins {
 			pins = "gpio1";
@@ -214,6 +269,9 @@ pcie@1,0 {
 			device_type = "pci";
 			ranges;
 			bus-range = <0x3 0xff>;
+			port {
+				tc9563_pcie1_ep: endpoint {};
+			};
 		};
 
 		pcie@2,0 {
@@ -252,3 +310,17 @@ pcie@0,1 {
 	};
 };
 
+&tc9563_pcie1_ep {
+	remote-endpoint = <&m2_e_pcie_ep>;
+};
+
+&uart2 {
+	status = "okay";
+
+	port {
+		uart2_ep: endpoint {
+			remote-endpoint = <&m2_e_uart_ep>;
+		};
+	};
+};
+
-- 
2.34.1

