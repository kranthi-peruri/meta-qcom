From a3e8da82c9fd9b6cc064172e06def457f14b798b Mon Sep 17 00:00:00 2001
From: Mohit Dsor <mohit.dsor@oss.qualcomm.com>
Date: Wed, 23 Sep 2026 16:36:30 +0530
Subject: [PATCH 07/15] PENDING: arm64: dts: qcom: lemans-draco-evk: Add
 LT9611UXD HDMI bridge support

Enable the MDSS display subsystem on the Qualcomm Lemans Draco EVK
board and add the Lontium LT9611UXD DSI-to-HDMI bridge node.

Signed-off-by: Mohit Dsor <mohit.dsor@oss.qualcomm.com>
Upstream-Status: Pending
---
 arch/arm64/boot/dts/qcom/lemans-draco-evk.dts | 161 ++++++++++++++++++
 1 file changed, 161 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts b/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts
index 07a34ee59eee..a95df37a79c5 100644
--- a/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts
+++ b/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts
@@ -16,6 +16,17 @@ aliases {
 		serial1 = &uart17;
 	};
 
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con: endpoint {
+				remote-endpoint = <&lt9611uxd_out>;
+			};
+		};
+	};
+
 	vreg_0p9: regulator-0v9 {
 		compatible = "regulator-fixed";
 		regulator-name = "VREG_0P9";
@@ -34,6 +45,24 @@ vreg_1p8: regulator-1v8 {
 		regulator-boot-on;
 	};
 
+	vreg_bridge_1p2: regulator-bridge-1p2 {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_bridge_1p2";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		gpio = <&expander2 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vreg_bridge_3p3: regulator-bridge-3p3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_bridge_3p3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&expander2 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	vreg_keye_3p3: regulator-keye-3p3 {
 		compatible = "regulator-fixed";
 		regulator-name = "vreg_keye_3p3";
@@ -74,7 +103,68 @@ m2_e_uart_ep: endpoint@0 {
 			};
 		};
 	};
+};
+
+&i2c1 {
+	status = "okay";
+
+	i2c-mux@70 {
+		compatible = "nxp,pca9548";
+		reg = <0x70>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		vcc-supply = <&vreg_s4a>;
+
+		i2c@0 {
+			reg = <0>;
+			#address-cells = <1>;
+			#size-cells = <0>;
 
+			lt9611uxd: hdmi-bridge@41 {
+				compatible = "lontium,lt9611uxd";
+				reg = <0x41>;
+
+				reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
+				interrupts-extended = <&tlmm 97 IRQ_TYPE_EDGE_FALLING>;
+
+				vcc-supply = <&vreg_bridge_3p3>;
+				vdd-supply = <&vreg_bridge_1p2>;
+
+				pinctrl-0 = <&bridge_rst_pin &bridge_irq_pin>;
+				pinctrl-names = "default";
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					/* DSI0 input */
+					port@0 {
+						reg = <0>;
+						lt9611uxd_in0: endpoint {
+							remote-endpoint = <&mdss0_dsi0_out>;
+						};
+					};
+
+					/* DSI1 input - disabled for single-DSI bringup, see &mdss0_dsi1
+					 * port@1 {
+					 *	reg = <1>;
+					 *	lt9611uxd_in1: endpoint {
+					 *		remote-endpoint = <&mdss0_dsi1_out>;
+					 *	};
+					 * };
+					 */
+
+					/* HDMI output */
+					port@2 {
+						reg = <2>;
+						lt9611uxd_out: endpoint {
+							remote-endpoint = <&hdmi_con>;
+						};
+					};
+				};
+			};
+		};
+	};
 };
 
 &i2c2 {
@@ -94,6 +184,12 @@ expander1: gpio@21 {
 		gpio-controller;
 	};
 
+	/*
+	 * U422: 16-bit GPIO expander (KTS1620EUAA-TR, TCA6416-compatible)
+	 * Address 0x22 (A1=VDD, A2=A0=GND).
+	 * INT_N → SoC TLMM gpio22.
+	 * Port 3 drives LT9611UXD bridge 3.3 V supply enable.
+	 */
 	expander2: gpio@22 {
 		compatible = "ti,tca6416";
 		reg = <0x22>;
@@ -133,6 +229,21 @@ mac_addr0: mac-addr@0 {
 };
 
 &tlmm {
+	bridge_irq_pin: bridge-irq-state {
+		pins = "gpio97";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	bridge_rst_pin: bridge-rst-state {
+		pins = "gpio39";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
 	expander_int: expander-int-state {
 		pins = "gpio22";
 		function = "gpio";
@@ -325,6 +436,56 @@ &tc9563_pcie1_ep {
 	remote-endpoint = <&m2_e_pcie_ep>;
 };
 
+&mdss0 {
+	status = "okay";
+};
+
+&mdss0_dsi0 {
+	vdda-supply = <&vreg_l1c>;
+
+	/* Dual-DSI (bonded) mode disabled for single-DSI bringup
+	 * qcom,dual-dsi-mode;
+	 * qcom,master-dsi;
+	 */
+
+	status = "okay";
+};
+
+&mdss0_dsi0_out {
+        remote-endpoint = <&lt9611uxd_in0>;
+        data-lanes = <0 1 2 3>;
+};
+
+&mdss0_dsi0_phy {
+	vdds-supply = <&vreg_l4a>;
+
+	status = "okay";
+};
+
+/* DSI1 disabled for single-DSI bringup
+ * &mdss0_dsi1 {
+ *	vdda-supply = <&vreg_l1c>;
+ *
+ *	qcom,dual-dsi-mode;
+ *
+ *	assigned-clock-parents = <&mdss0_dsi0_phy DSI_BYTE_PLL_CLK>,
+ *				 <&mdss0_dsi0_phy DSI_PIXEL_PLL_CLK>;
+ *
+ *	status = "okay";
+ * };
+ *
+ * &mdss0_dsi1_out {
+ *	remote-endpoint = <&lt9611uxd_in1>;
+ *	data-lanes = <0 1 2 3>;
+ * };
+ *
+ * &mdss0_dsi1_phy {
+ *	vdds-supply = <&vreg_l4a>;
+ *
+ *	status = "okay";
+ * };
+ */
+
 &uart17 {
 	status = "okay";
 
-- 
2.34.1
