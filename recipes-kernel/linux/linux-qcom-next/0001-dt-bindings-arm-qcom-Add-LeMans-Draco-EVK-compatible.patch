From ce00daf14163516d600de4cc61064160cad0b5d3 Mon Sep 17 00:00:00 2001
From: Gopikishan Thawre <gthawre@qti.qualcomm.com>
Date: Thu, 10 Sep 2026 14:44:31 +0530
Subject: [PATCH 1/4] dt-bindings: arm: qcom: Add LeMans Draco EVK compatible
 strings

Add the compatible string for the Qualcomm LeMans Draco EVK board
(SA8775P/QCS9100 SoC). The compatible chain is:
  qcom,lemans-draco-evk
  qcom,lemans-draco-evk-som
  qcom,qcs9100
  qcom,sa8775p

Signed-off-by: Gopikishan Thawre <gthawre@qti.qualcomm.com>
Upstream-Status: Pending
---
 Documentation/devicetree/bindings/arm/qcom.yaml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/qcom.yaml b/Documentation/devicetree/bindings/arm/qcom.yaml
index ff8a35df7862..67530e35b79a 100644
--- a/Documentation/devicetree/bindings/arm/qcom.yaml
+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -467,6 +467,13 @@ properties:
               - qcom,sa8775p-ride-r3
           - const: qcom,sa8775p
 
+      - items:
+          - enum:
+              - qcom,lemans-draco-evk
+          - const: qcom,lemans-draco-evk-som
+          - const: qcom,qcs9100
+          - const: qcom,sa8775p
+
       - items:
           - enum:
               - qcom,lemans-evk
