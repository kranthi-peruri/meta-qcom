From 72243aa60c55dd2d981680abd8b30c87c6ba6b28 Mon Sep 17 00:00:00 2001
From: Khalid Faisal Ansari <khalid.ansari@oss.qualcomm.com>
Date: Thu, 1 Oct 2026 14:10:39 +0530
Subject: [PATCH 4/4] arm64: dts: qcom: lemans-draco-evk: Enable TPM

Enable ST33HTPM TPM over SPI16 on the LeMans IoT EVK by adding the
required SPI and TPM nodes.

Upstream-Status: Pending
Signed-off-by: Khalid Faisal Ansari <khalid.ansari@oss.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/lemans-draco-evk.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts b/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts
index 49b5646e5eb3..1d71b2458cfc 100644
--- a/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts
+++ b/arch/arm64/boot/dts/qcom/lemans-draco-evk.dts
@@ -686,6 +686,16 @@ max98091: max98091@10 {
 	};
 };
 
+&spi16 {
+        status = "okay";
+
+        tpm@0 {
+                compatible = "st,st33htpm-spi", "tcg,tpm_tis-spi";
+                reg = <0>;
+                spi-max-frequency = <20000000>;
+        };
+};
+
 &tlmm {
 	bridge_irq_pin: bridge-irq-state {
 		pins = "gpio97";
-- 
2.34.1
